# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
.python-version

# Jupyter
.ipynb_checkpoints/

# Data (never committed - generated locally from config/generator.yaml)
data/*
!data/.gitkeep

# Outputs (regenerated by training/eval runs)
outputs/figures/*
!outputs/figures/.gitkeep

# Model artifacts and out-of-fold predictions (regenerable from seed and config).
# Run manifests (outputs/*.json) and result CSVs are deliberately NOT ignored:
# provenance is a deliverable and is committed with the code that produced it.
outputs/*.parquet
outputs/*.pkl
outputs/*.joblib
*.xgb

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment / secrets
.env
