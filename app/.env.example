# Ledgerfield configuration. Copy to .env and adjust. Every value the app reads
# at runtime is listed here; nothing secret is committed.

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. The default matches `npm run db:start`, which
# runs a local PostgreSQL from the embedded-postgres package on port 5433.
DATABASE_URL="postgresql://ledgerfield:ledgerfield@127.0.0.1:5433/ledgerfield"
# Used only by the test suite. Tests truncate every table, so never point this
# at a database you care about.
TEST_DATABASE_URL="postgresql://ledgerfield:ledgerfield@127.0.0.1:5433/ledgerfield_test"

# Settings for `npm run db:start` (local development only).
LOCAL_PG_PORT=5433
LOCAL_PG_USER=ledgerfield
LOCAL_PG_PASSWORD=ledgerfield
LOCAL_PG_DATABASES=ledgerfield,ledgerfield_test

# --- Authentication -------------------------------------------------------
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Scoring service ------------------------------------------------------
# Base URL of the fraud-scoring FastAPI service at the repository root.
SCORING_SERVICE_URL="http://127.0.0.1:8000"
# Python used by `npm run dev:all` to start the scoring service. Defaults to
# the repository's .venv (.venv/Scripts/python.exe on Windows, .venv/bin/python
# elsewhere). Uncomment to override.
# SCORING_PYTHON=""
# Per-request timeout. The first call after the service starts can be slow.
SCORING_TIMEOUT_MS=15000
# Immediate attempts within one scoring run before it counts as failed.
SCORING_IMMEDIATE_ATTEMPTS=3
# Delay before the second immediate attempt; doubles for each further one.
SCORING_IMMEDIATE_BACKOFF_MS=500
# Background retries after a failed run: first retry after this many seconds,
# doubling each time, up to SCORING_MAX_RUNS runs in total.
SCORING_RETRY_BASE_SECONDS=60
SCORING_MAX_RUNS=6

# --- Hold window and scheduler -------------------------------------------
# Seconds between submission (T0) and hold-close scoring (T7). 604800 = 7 days.
HOLD_WINDOW_SECONDS=604800
# How often `npm run scheduler` looks for due scoring jobs.
SCHEDULER_INTERVAL_SECONDS=30
# How long a claimed job stays locked before another worker may reclaim it.
SCHEDULER_LEASE_SECONDS=120
# Shared secret for POST /api/cron/scoring (for a hosted cron service).
CRON_SECRET="replace-with-a-long-random-string"

# --- Payouts ---------------------------------------------------------------
# Which PayoutAuthoriser records an approved payout. Only "noop" exists: it
# records the authorisation and moves no money (settlement is issue #14).
PAYOUT_AUTHORISER=noop

# --- Data handling --------------------------------------------------------
# Salt mixed into customer phone numbers before hashing. Changing it breaks
# repeat-number detection against earlier activations.
MSISDN_HASH_SALT="replace-with-a-long-random-string"
# Directory for uploaded evidence files, relative to app/.
EVIDENCE_STORAGE_DIR="storage/evidence"
# Largest accepted upload per file, in bytes.
EVIDENCE_MAX_BYTES=8000000

# --- Test-only ---------------------------------------------------------------
# Live tests run only when these answer; they are skipped otherwise.
# LIVE_SCORING_URL="http://127.0.0.1:8000"   # tests/scoring-live.test.ts, tests/seed-live.test.ts
# APP_URL="http://localhost:3000"            # tests/api-live.test.ts and npm run demo:rehearse
