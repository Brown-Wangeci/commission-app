# Ledgerfield configuration. Copy to .env and adjust. Every value the app reads
# at runtime is listed here; nothing secret is committed.

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. The default matches `npm run db:start`, which
# runs a local PostgreSQL from the embedded-postgres package on port 5433.
DATABASE_URL="postgresql://ledgerfield:ledgerfield@127.0.0.1:5433/ledgerfield"
# Used only by the test suite. Tests truncate every table, so never point this
# at a database you care about.
TEST_DATABASE_URL="postgresql://ledgerfield:ledgerfield@127.0.0.1:5433/ledgerfield_test"

# Settings for `npm run db:start` (local development only).
LOCAL_PG_PORT=5433
LOCAL_PG_USER=ledgerfield
LOCAL_PG_PASSWORD=ledgerfield
LOCAL_PG_DATABASES=ledgerfield,ledgerfield_test

# --- Authentication -------------------------------------------------------
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Scoring service ------------------------------------------------------
# Base URL of the fraud-scoring FastAPI service at the repository root.
SCORING_SERVICE_URL="http://127.0.0.1:8000"
# Python used by `npm run dev:all` to start the scoring service. Defaults to
# the repository's .venv (.venv/Scripts/python.exe on Windows, .venv/bin/python
# elsewhere). Uncomment to override.
# SCORING_PYTHON=""
# Per-request timeout. The first call after the service starts can be slow.
SCORING_TIMEOUT_MS=15000
# Immediate attempts within one scoring run before it counts as failed.
SCORING_IMMEDIATE_ATTEMPTS=3
# Delay before the second immediate attempt; doubles for each further one.
SCORING_IMMEDIATE_BACKOFF_MS=500
# Background retries after a failed run: first retry after this many seconds,
# doubling each time, up to SCORING_MAX_RUNS runs in total.
SCORING_RETRY_BASE_SECONDS=60
SCORING_MAX_RUNS=6

# --- Hold window and scheduler -------------------------------------------
# Seconds between submission (T0) and hold-close scoring (T7). 604800 = 7 days.
HOLD_WINDOW_SECONDS=604800
# How often `npm run scheduler` looks for due scoring jobs.
SCHEDULER_INTERVAL_SECONDS=30
# How long a claimed job stays locked before another worker may reclaim it.
SCHEDULER_LEASE_SECONDS=120
# Shared secret for POST /api/cron/scoring (for a hosted cron service).
CRON_SECRET="replace-with-a-long-random-string"

# --- M-Pesa (Daraja) ------------------------------------------------------
# Set these in the .env at the REPOSITORY ROOT, not in this file's copy: only
# their names are listed here. The app reads the MPESA_ names from the root
# .env as well as app/.env, and a value already set is never replaced, so they
# are commented out to stop a copy of this file hiding the real ones. Without
# them the app runs, funding is refused, and queued payouts wait, unspent.
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY="replace-with-your-value"
# MPESA_CONSUMER_SECRET="replace-with-your-value"
# The Paybill or Till that receives STK Push payments, and its passkey.
# MPESA_STK_SHORTCODE="replace-with-your-value"
# MPESA_STK_PASSKEY="replace-with-your-value"
# The shortcode B2C payouts leave from, its API user, and that user's password
# as encrypted by the Daraja portal's test credentials page.
# MPESA_B2C_SHORTCODE="replace-with-your-value"
# MPESA_B2C_INITIATOR_NAME="replace-with-your-value"
# MPESA_B2C_SECURITY_CREDENTIAL="replace-with-your-value"
#
# Public HTTPS origin that Daraja calls back to, with no path. Daraja cannot
# reach localhost and requires HTTPS, so local development needs a tunnel:
#     cloudflared tunnel --url http://localhost:3000
# which prints an https://<random>.trycloudflare.com address. That address
# changes every time the tunnel restarts: update this value and restart the
# app. Every callback URL is built from it when an instruction is sent, and
# Daraja keeps using the address it was given, so a tunnel that goes away takes
# any result still on its way with it. See "M-Pesa" in README.md.
# MPESA_CALLBACK_BASE_URL="https://your-tunnel-host.example"

# Non-secret settings. The defaults below are used if these are left unset.
# Milliseconds to wait for Daraja before treating a send as
# unknown. Assumption, not from Daraja's documentation.
MPESA_TIMEOUT_MS=30000
# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till.
MPESA_STK_TRANSACTION_TYPE=CustomerPayBillOnline
# BusinessPayment, SalaryPayment or PromotionPayment.
MPESA_B2C_COMMAND_ID=BusinessPayment
# Refuse amounts with cents rather than send them. Assumption: Daraja's
# documentation says only "Numeric". Set to false once the sandbox shows that
# cents are paid exactly. Nothing is ever rounded either way.
MPESA_WHOLE_SHILLINGS_ONLY=true
# Limits in cents, from Daraja's documentation: STK from KSh 1, B2C from KSh 10,
# both up to KSh 250,000 per transaction.
MPESA_STK_MIN_CENTS=100
MPESA_STK_MAX_CENTS=25000000
MPESA_B2C_MIN_CENTS=1000
MPESA_B2C_MAX_CENTS=25000000
# Optional second origin check, on top of the signed URL: comma-separated
# addresses or IPv4 ranges. Empty means no source check. Safaricom's addresses
# are not in the Daraja documentation, so fill this only from addresses you have
# confirmed. It reads X-Forwarded-For, so it needs a proxy that sets that header.
MPESA_CALLBACK_ALLOWED_IPS=
# When set, real exchanges with Daraja are written here, redacted, as evidence.
# MPESA_CAPTURE_DIR="../docs/chapter5/evidence/mpesa/run"

# --- Payment queue --------------------------------------------------------
# All assumptions. npm run scheduler works this queue; so does POST
# /api/cron/payments with CRON_SECRET.
# Payout retries: first after this many seconds, doubling, up to the limit.
# The defaults give six tries over about 31 minutes.
PAYMENT_RETRY_BASE_SECONDS=60
PAYMENT_MAX_SENDS=6
# How long to wait for a payout result before asking Daraja, and how many times
# to ask before raising it to an administrator. It is never sent again.
PAYMENT_RESULT_WAIT_SECONDS=900
PAYMENT_MAX_STATUS_QUERIES=3
# The same for funding, shorter because someone is waiting at their phone.
FUNDING_RETRY_BASE_SECONDS=15
FUNDING_MAX_SENDS=3
FUNDING_RESULT_WAIT_SECONDS=180
FUNDING_MAX_STATUS_QUERIES=3

# --- Data handling --------------------------------------------------------
# Salt mixed into customer phone numbers before hashing. Changing it breaks
# repeat-number detection against earlier activations.
MSISDN_HASH_SALT="replace-with-a-long-random-string"
# Directory for uploaded evidence files, relative to app/.
EVIDENCE_STORAGE_DIR="storage/evidence"
# Largest accepted upload per file, in bytes.
EVIDENCE_MAX_BYTES=8000000

# --- Test-only ---------------------------------------------------------------
# Live tests run only when these answer; they are skipped otherwise.
# LIVE_SCORING_URL="http://127.0.0.1:8000"   # tests/scoring-live.test.ts, tests/seed-live.test.ts
# APP_URL="http://localhost:3000"            # tests/api-live.test.ts and npm run demo:rehearse
